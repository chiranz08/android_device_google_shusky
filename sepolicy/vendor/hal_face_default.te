# Google face HAL reads /metadata at init. Denied on LineageOS's zuma policy
# ("avc: denied { read } ... scontext=u:r:hal_face_default:s0 tcontext=u:object_r:metadata_file:s0 tclass=dir"),
# seen on-device on Mist-OS 17; Voltage shipped the same rule. Read-only, directory only.
allow hal_face_default metadata_file:dir r_dir_perms;

# Google face HAL calls back into the enrollment UI (SettingsGoogleFutureFaceEnroll, system_app).
# Denied twice during enrollment on device; crDroid's faceunlock policy grants the same.
binder_call(hal_face_default, system_app)
